#!/bin/sh
set -eu
TMUX_ROAM_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${TMUX_ROAM_BACKEND:-go}" in
    python) exec "$TMUX_ROAM_ROOT/bin/tmux-roam-python" "$@" ;;
    go) ;;
    *) printf '%s\n' 'tmux-roam: TMUX_ROAM_BACKEND must be go or python' >&2; exit 2 ;;
esac
if [ -x "$TMUX_ROAM_ROOT/.runtime/current/tmux-roam" ]; then
    exec "$TMUX_ROAM_ROOT/.runtime/current/tmux-roam" "$@"
fi
if [ -x "$TMUX_ROAM_ROOT/build/tmux-roam-go" ]; then
    exec "$TMUX_ROAM_ROOT/build/tmux-roam-go" "$@"
fi
printf '%s\n' 'tmux-roam: no Go bundle installed. Run scripts/install-go.sh BUNDLE SHA256, or build explicitly with scripts/build-go.sh. Use TMUX_ROAM_BACKEND=python for rollback.' >&2
exit 2
